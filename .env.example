# WasteWise AI — Local Development Environment
# This file is gitignored. Generated from .env.example.

# === Database (Postgres / Supabase) ===
DATABASE_URL=postgresql://postgres:password@db.project_ref.supabase.co:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# === Supabase (Backend Only) ===
SUPABASE_URL=https://project_ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Backend (FastAPI) ===
SECRET_KEY=dev_secret_key_not_for_production_use_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=local

# === Routing Engine ===
ROUTING_ENGINE_URL=https://router.project-osrm.org

# === AI / Computer Vision (Backend Only — Never expose to Frontend) ===
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=25

# === Frontend & Maps ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=https://project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

