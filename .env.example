# ============================================================
# WasteWise AI — Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# === Database (Postgres + PostGIS) ===
POSTGRES_USER=wastewise
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=wastewise
DATABASE_URL=postgresql+asyncpg://wastewise:changeme_dev@postgres:5432/wastewise

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Backend (FastAPI) ===
SECRET_KEY=changeme_generate_a_real_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=local

# === Routing Engine ===
# Using OSRM public demo for dev; self-host in Phase 3+
ROUTING_ENGINE_URL=https://router.project-osrm.org

# === AI/ML (populated in Phase 2+) ===
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# === Frontend (Next.js — NEXT_PUBLIC_ prefix exposes to browser) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=
